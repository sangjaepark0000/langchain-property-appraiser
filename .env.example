# Application
APP_NAME=langchain-property-appraiser
APP_ENV=local
LOG_LEVEL=INFO

# Database
# Story 1.3 will add local PostgreSQL + pgvector Docker Compose.
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/langchain_property_appraiser

# LLM provider
# Use provider-specific real keys only in your local .env, never in committed files.
LLM_PROVIDER=none
LLM_API_KEY=

# Embedding provider
# Local smoke flows should tolerate missing embedding keys until a provider is configured.
EMBEDDING_PROVIDER=none
EMBEDDING_API_KEY=

# LangSmith tracing
# Tracing is disabled unless LANGSMITH_TRACING=true and LANGSMITH_API_KEY is set locally.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=langchain-property-appraiser-local
